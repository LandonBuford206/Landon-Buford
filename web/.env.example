# Copy to .env.local for local development.
# In production, set these in the Vercel project settings.
#
# WARNING: `vercel link` and `vercel env pull` will OVERWRITE .env.local
# with whatever Vercel returns (often just VERCEL_OIDC_TOKEN), wiping out
# any hand-written secrets below. Back up .env.local before running the
# Vercel CLI, or rebuild it from this template afterward.

# Used in canonical URLs, RSS, sitemap, OG tags. Set to your live URL.
NEXT_PUBLIC_SITE_URL=https://landonbuford.com

# AdSense publisher ID, e.g. ca-pub-1234567890123456
# Without this, ad slots render as labeled placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Per-placement AdSense slot IDs (from the AdSense console).
# Optional — defaults are placeholders.
NEXT_PUBLIC_ADSENSE_SLOT_INARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Newsletter signup endpoint (Beehiiv form action URL, ConvertKit, etc.)
# Without this, the form just shows a thank-you message.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Resend API key for the /contact form (https://resend.com).
# Without this, the form returns a 503 "not configured" message.
RESEND_API_KEY=

# --- Admin / publish flow (Phase-2 CMS) ---

# Password for the single admin user (Landon). Compared via timing-safe equal.
ADMIN_PASSWORD=

# 32+ random bytes used to sign session JWTs.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Anthropic API key for the AI article-formatter.
ANTHROPIC_API_KEY=

# GitHub fine-grained PAT with `contents: write` on this repo only.
GITHUB_TOKEN=

# Repo to commit new posts into, as `owner/name`.
GITHUB_REPO=connectwithpatrick/landonbuford

# Branch to commit to. Use a throwaway branch (e.g. `cms-test`) when testing.
GITHUB_BRANCH=main
