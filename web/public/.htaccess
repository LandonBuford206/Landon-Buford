# Apache config for the static export on SiteGround (web/out -> public_html).
# Mirrors the redirects in next.config.ts — keep the two in sync.

Options -MultiViews -Indexes

# /category/music is both music.html and a music/ directory (for /page/N).
# Without this, Apache would redirect to /category/music/ before the
# .html rewrite below gets a chance.
DirectorySlash Off

ErrorDocument 404 /404.html

RewriteEngine On

# www -> apex
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Trailing slashes were never used.
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Old ?page=N archive URLs -> /page/N
RewriteCond %{QUERY_STRING} (?:^|&)page=(\d+)
RewriteRule ^(category|tag|author)/([^/]+)$ /$1/$2/page/%1? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)page=\d+
RewriteRule ^$ /? [R=301,L]

# Homepage pagination (WordPress) — the homepage is not paginated.
RewriteRule ^page/\d+$ / [R=301,L]

# RSS — WordPress used /feed and /<archive>/feed.
RewriteRule ^feed$ /feed.xml [R=301,L]
RewriteRule ^(category|tag|author)/[^/]+/feed$ /feed.xml [R=301,L]

# Category consolidation (2026-05-07)
RewriteRule ^category/music-news(-2|-3)?$ /category/music [R=301,L]
RewriteRule ^category/wnba-sports$ /category/wnba [R=301,L]
RewriteRule ^category/business-news-2$ /category/business [R=301,L]
RewriteRule ^category/youtube-music$ /category/youtube [R=301,L]
RewriteRule ^category/uncategorized$ /category/general [R=301,L]

# Author consolidation (2026-05-10)
RewriteRule ^author/chad-hughes$ /author/landon-buford [R=301,L]

# WordPress dated permalinks (2026-05-12)
RewriteRule ^\d{4}/\d{2}/\d{2}/([^/]+)$ /$1 [R=301,L]

# Former Vercel API path for the search index.
RewriteRule ^api/search-index$ /search-index.json [R=301,L]

# Extensionless URLs -> the exported .html file.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]

# Metadata image routes are exported without a file extension.
<FilesMatch "^(opengraph-image|twitter-image)$">
  ForceType image/png
</FilesMatch>

<IfModule mod_headers.c>
  # Hashed build assets never change.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
